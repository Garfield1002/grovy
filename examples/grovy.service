# systemd user unit for the grovy daemon.
#   cp examples/grovy.service ~/.config/systemd/user/ && edit paths/env
#   systemctl --user daemon-reload && systemctl --user enable --now grovy
#   loginctl enable-linger $USER   # keep it running while logged out
# Restarting/stopping this unit never affects Claude sessions (they live in tmux).
[Unit]
Description=grovy - Claude Code session manager daemon

[Service]
ExecStart=%h/dev/grovy/grovy serve
# Bind to your VPN interface address (e.g. your WireGuard IP). Default is loopback only.
Environment=GROVY_BIND=127.0.0.1
Environment=GROVY_PORT=7333
# Beyond loopback a token is required automatically: run `grovy url` and open the link once per device.
# Optional notifications: any command; receives the message on stdin.
#Environment=GROVY_NOTIFY_CMD=%h/dev/grovy/examples/notify-telegram.sh
#Environment=GROVY_PUBLIC_URL=http://100.x.y.z:7333/
# Optional HTTPS: `grovy tls init` needs nothing here. To use your own certificate instead:
#Environment=GROVY_TLS_CERT=/path/to/fullchain.pem
#Environment=GROVY_TLS_KEY=/path/to/privkey.pem
# systemd's PATH usually lacks ~/.local/bin and nvm paths: give the daemon (and the Claude sessions it starts,
# whose Bash tool inherits this) the PATH you use in a terminal, or set GROVY_CLAUDE to claude's full path.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
#Environment=GROVY_CLAUDE=%h/.local/bin/claude
Restart=on-failure
RestartSec=2
# Essential: if this daemon is what starts the tmux server (first "New session" from the phone), tmux is in
# this unit's cgroup, and the default KillMode would kill tmux and every Claude session on restart or crash.
KillMode=process

[Install]
WantedBy=default.target
