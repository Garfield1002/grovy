# systemd user unit for the ccs daemon.
#   cp examples/ccs.service ~/.config/systemd/user/ && edit paths/env
#   systemctl --user daemon-reload && systemctl --user enable --now ccs
#   loginctl enable-linger $USER   # keep it running while logged out
# Restarting/stopping this unit never affects Claude sessions (they live in tmux).
[Unit]
Description=ccs - Claude Code session manager daemon

[Service]
ExecStart=%h/dev/grovy/ccs serve
# Bind to your VPN interface address (e.g. Tailscale/WireGuard IP). Default is loopback only.
Environment=CCS_BIND=127.0.0.1
Environment=CCS_PORT=7333
# Beyond loopback a token is required automatically: run `ccs url` and open the link once per device.
# Optional notifications: any command; receives the message on stdin.
#Environment=CCS_NOTIFY_CMD=%h/dev/grovy/examples/notify-telegram.sh
#Environment=CCS_PUBLIC_URL=http://100.x.y.z:7333/
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
