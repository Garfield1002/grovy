    "hooks": [
     {
      "type": "command",
      "command": "'python3' '/path/to/grovy/grovy.py' 'hook' 'NAME'",
      "timeout": 10
     }
    ]
   }
  ],
  "PostToolUse": [
   {
    "matcher": "*",
    "hooks": [
     {
      "type": "command",
      "command": "'python3' '/path/to/grovy/grovy.py' 'hook' 'NAME'",
      "timeout": 10
     }
    ]
   }
  ]
 }
}
