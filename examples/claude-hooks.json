{
 "hooks": {
  "SessionStart": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "'python3' '/path/to/grovy/grovy.py' 'hook' 'NAME'",
      "timeout": 10
     }
    ]
   }
  ],
  "SessionEnd": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "'python3' '/path/to/grovy/grovy.py' 'hook' 'NAME'",
      "timeout": 10
     }
    ]
   }
  ],
  "UserPromptSubmit": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "'python3' '/path/to/grovy/grovy.py' 'hook' 'NAME'",
      "timeout": 10
     }
    ]
   }
  ],
  "PermissionRequest": [
   {
    "matcher": "*",
    "hooks": [
     {
      "type": "command",
      "command": "'python3' '/path/to/grovy/grovy.py' 'hook' 'NAME'",
      "timeout": 630
     }
    ]
   }
  ],
  "Notification": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "'python3' '/path/to/grovy/grovy.py' 'hook' 'NAME'",
      "timeout": 10
     }
    ]
   }
  ],
  "Stop": [
